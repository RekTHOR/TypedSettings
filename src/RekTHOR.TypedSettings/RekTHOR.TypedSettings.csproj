<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>TypedSettings</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>RekTHOR.TypedSettings</PackageId>
        <Version>0.1.0</Version>
        <Authors>RekTHOR</Authors>
        <Description>Strongly typed, validated settings on top of the Options pattern: the type names its own configuration section, DI hands out the plain settings object, and an enum picks the reload behaviour.</Description>
        <PackageTags>settings;configuration;options;dependency-injection;validation</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/RekTHOR/TypedSettings</PackageProjectUrl>
        <RepositoryUrl>https://github.com/RekTHOR/TypedSettings</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10"/>
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
